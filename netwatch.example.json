{
  "host": "netwatch-host",
  "page_url": "http://netwatch.lan/netwatch/",
  "lan_prefix": "192.168.1",
  "out_dir": "~/netwatch/data",
  "summary_path": "",
  "pushgateway": "",
  "history_len": 288,
  "ping": {
    "count": 10,
    "interval": 0.2,
    "timeout": 1.0
  },
  "speedtest": {
    "enabled": false,
    "interval_s": 1800,
    "bytes": 25000000
  },
  "alerting": {
    "degraded_loss_pct": 5,
    "debounce_samples": 2,
    "blip_suppress_s": 600
  },
  "targets": [
    {
      "id": "router",
      "name": "Router",
      "ip": "192.168.1.1",
      "kind": "wired",
      "alert_loss_pct": 30,
      "note": "raise alert_loss_pct if your router deprioritises ICMP to itself"
    },
    {
      "id": "nas",
      "name": "NAS",
      "ip": "192.168.1.10",
      "kind": "wired",
      "note": "hardwired"
    },
    {
      "id": "pc",
      "name": "Desktop",
      "ip": "192.168.1.50",
      "kind": "wired",
      "mac": "aa:bb:cc:dd:ee:ff",
      "note": "mac is optional \u2014 it survives DHCP drift (see README)"
    },
    {
      "id": "ap1",
      "name": "AP upstairs",
      "ip": "192.168.1.97",
      "kind": "ap",
      "note": "wired backhaul"
    },
    {
      "id": "laptop",
      "name": "Laptop",
      "ip": "192.168.1.120",
      "kind": "wifi",
      "note": "5 GHz"
    },
    {
      "id": "wan",
      "name": "Internet",
      "ip": "1.1.1.1",
      "kind": "wan",
      "note": "ICMP to Cloudflare"
    }
  ],
  "services": [
    {
      "id": "router-ui",
      "name": "Router admin",
      "url": "http://192.168.1.1/"
    },
    {
      "id": "ha",
      "name": "Home Assistant",
      "url": "http://192.168.1.10:8123/"
    }
  ]
}
